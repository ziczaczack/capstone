    id INTEGER PRIMARY KEY AUTOINCREMENT,
    product_id INTEGER,
    inventory_id INTEGER,
    usage REAL,
    unit TEXT,
    FOREIGN KEY (product_id) REFERENCES products(id),
    FOREIGN KEY (inventory_id) REFERENCES inventory(id)
);</sql><current_tab id="0"/></tab_sql></sqlb_project>
