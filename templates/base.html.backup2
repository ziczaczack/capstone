<!DOCTYPE html>
<html>

<head>
    <title>{% block title %}Cafe Inventory{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .user-profile-section {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-left: auto;
        }

        .user-info {
            text-align: right;
            font-size: 14px;
        }

        .username {
            font-weight: bold;
            color: #333;
        }

        .role-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
            text-transform: uppercase;
        }

        .role-badge.superadmin {
            background-color: #dc3545;
            color: white;
        }

        .role-badge.staff {
            background-color: #28a745;
            color: white;
        }

        .main-content {
            flex: 1;
            padding: 20px;
            background-image: url('/static/images/background.png');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
        }

        /* Back to top button */
        .back-to-top {
            position: fixed;
            right: 18px;
            bottom: 18px;
            z-index: 1050;
            display: none;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, 0.65);
            color: #fff;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            cursor: pointer;
        }

        .back-to-top:hover {
            background: rgba(0, 0, 0, 0.8);
        }

        .navbar-brand img {
            height: 40px;
            margin-right: 10px;
        }
    </style>
    {% block extra_css %}{% endblock %}
</head>

<body>
    <!-- Navigation Bar with User Profile -->
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container-fluid">
            <div class="username">{{ current_user.username }}</div>
            <span class="role-badge {{ current_user.role.lower() }}">{{ current_user.role }}</span>
        </div>
        <a href="/profile" class="btn btn-outline-secondary btn-sm" title="View Profile">👤</a>
        <a href="/logout" class="btn btn-outline-danger btn-sm">Logout</a>
        {% else %}
        <a href="/login" class="btn btn-primary btn-sm">Login</a>
        {% endif %}
        </div>
        </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="main-content">
        {% with messages = get_flashed_messages() %}
        {% if messages %}
        {% for message in messages %}
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        {% endfor %}
        {% endif %}
        {% endwith %}

        {% block content %}{% endblock %}
    </div>

    <!-- Back to top button -->
    <div class="back-to-top" id="backToTop" title="Back to top" aria-hidden="true">
        ↑
    </div>

    <!-- Footer -->
    <footer class="bg-light text-center py-3 mt-5" style="border-top: 1px solid #ddd;">
        <small class="text-muted">Cafe Inventory System © 2025</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        (function () {
            const btn = document.getElementById('backToTop');
            if (!btn) return;
            const threshold = 200;
            function onScroll() {
                try {
                    if (window.pageYOffset > threshold) btn.style.display = 'flex';
                    else btn.style.display = 'none';
                } catch (e) { }
            }
            function scrollToTop() {
                try { window.scrollTo({ top: 0, behavior: 'smooth' }); } catch (e) { window.scrollTo(0, 0); }
            }
            window.addEventListener('scroll', onScroll, { passive: true });
            btn.addEventListener('click', scrollToTop);
            onScroll();
        })();
    </script>
    {% block extra_js %}{% endblock %}
</body>

</html>